{
  "expo": {
    "name": "MacroTrack",
    "slug": "macrotrack",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1116",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nikkras.macrotrack"
    },
    "android": {
      "package": "com.nikkras.macrotrack",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#39E08A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 2
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0E1116"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20"
          }
        }
      ],
      [
        "./plugins/withKotlinGradlePlugin",
        {
          "version": "2.2.20"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MacroTrack uses your photos to attach images to dishes and logged foods, and to recognise food in a photo.",
          "cameraPermission": "MacroTrack uses the camera to photograph a meal so it can list the foods on the plate."
        }
      ],
      "expo-sqlite",
      "./plugins/withReleaseSigning",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "mykyta-krasnytskyi",
          "project": "macrotrack"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "97e149cf-378a-4190-9b37-7ed227d981d9"
      }
    },
    "owner": "nikitakras",
    "scheme": "macrotrack",
    "icon": "./assets/icon.png"
  }
}
