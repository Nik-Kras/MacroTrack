{
  "expo": {
    "name": "MacroTrack",
    "slug": "macrotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1116",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nikkras.macrotrack"
    },
    "android": {
      "package": "com.nikkras.macrotrack",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116"
      }
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0E1116"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MacroTrack uses your photos to attach images to dishes and logged foods."
        }
      ],
      "expo-sqlite"
    ]
  }
}
